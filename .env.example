# GEMINI_API_KEY: Required for Gemini AI API calls (free tier gemini-2.5-flash + embeddings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Multi-Channel Webhook Tokens (Meta WhatsApp Cloud API & Facebook Messenger)
WHATSAPP_VERIFY_TOKEN="agripulse_wa_verify_2026"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
MESSENGER_VERIFY_TOKEN="agripulse_fb_verify_2026"
MESSENGER_PAGE_ACCESS_TOKEN=""
INSTAGRAM_VERIFY_TOKEN="agripulse_ig_verify_2026"
INSTAGRAM_ACCESS_TOKEN=""

# Optional External Agricultural Data Connectors (Open-Meteo & SoilGrids require zero API keys)
OPENWEATHER_API_KEY=""
USDA_QUICKSTATS_API_KEY=""

